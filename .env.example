# ============================================================
# FlyHigh Team Event — Live Auction Platform
# Copy this file to .env and fill in your values
# ============================================================
# This file documents ALL environment variables used by the app.
# Variables are grouped by where they're configured.

# ==========================
# BACKEND (set in Render)
# ==========================

# ----- Application -----
APP_ENV=development
# In production, use a strong random string (Render can auto-generate)
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
# Or use JWT_SECRET (takes precedence over SECRET_KEY):
# JWT_SECRET=your-super-secret-jwt-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ----- Database (Neon PostgreSQL) -----
# Get this from Neon dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ----- Redis (Upstash) -----
# Get this from Upstash dashboard → REST API section
REDIS_URL=rediss://default:xxxxx@xxxxx.upstash.io:6379

# ----- CORS -----
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://your-app.vercel.app
# Or use ALLOWED_ORIGINS (same effect):
# ALLOWED_ORIGINS=https://your-app.vercel.app

# ----- Frontend URL -----
# Auto-added to CORS origins if not already present
FRONTEND_URL=https://your-app.vercel.app

# ----- Admin Seed Account -----
# Used by: python -m app.scripts.seed
ADMIN_EMAIL=admin@flyhigh.com
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_USERNAME=admin

# ==========================
# FRONTEND (set in Vercel)
# ==========================

# ----- API URL -----
# Full URL to the deployed backend (Render)
VITE_API_URL=https://your-api.onrender.com

# ----- Socket.IO URL -----
# Same as API URL (Socket.IO runs on the same server)
VITE_SOCKET_URL=https://your-api.onrender.com
